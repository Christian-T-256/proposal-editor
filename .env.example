# Leave the Supabase values unset to run the fictional local demo.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=proposal-content

# Required when Supabase mode is enabled. Use a long, random value.
EDITOR_ACCESS_KEY=replace-with-a-long-random-access-key
